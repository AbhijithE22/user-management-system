<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>500 - Internal Server Error</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/500.css">
    
</head>
<body class="p-4 sm:p-8">

    <main class="w-full max-w-lg mx-auto text-center">
        
        <!-- Subtle background element with floating animation -->
        <div class="relative mb-8 flex justify-center items-center float-animation">
            <div class="absolute inset-0 bg-blue-50 rounded-full blur-3xl opacity-70 w-48 h-48 mx-auto"></div>
            
            <!-- Large 500 Text overlapping a gears icon -->
            <div class="relative z-10 flex flex-col items-center">
                <i class="fa-solid fa-gears fa-spin-pulse text-primary opacity-20 text-7xl absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2" style="--fa-animation-duration: 10s;"></i>
                <h1 class="text-8xl sm:text-9xl font-extrabold tracking-tighter text-gray-900 drop-shadow-sm">500</h1>
            </div>
        </div>
        
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-gray-900 mb-4">Internal Server Error</h2>
        
        <p class="text-base sm:text-lg text-textMuted mb-8 max-w-sm mx-auto">
            Oops! Something went wrong on our end. Our team has been automatically notified. Please try again in a few moments.
        </p>
        
        <div class="flex flex-col sm:flex-row justify-center gap-3">
            <button onclick="handleRetry(event)" class="btn-primary inline-flex items-center justify-center px-6 py-3 border border-transparent rounded-lg shadow-sm text-base font-medium text-white bg-primary hover:bg-primaryHover focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary">
                <i class="fa-solid fa-rotate-right mr-2"></i> Retry
            </button>
            <a href="home.html" onclick="handleGoHome(event)" class="inline-flex items-center justify-center px-6 py-3 border border-gray-300 rounded-lg shadow-sm text-base font-medium text-gray-700 bg-white hover:bg-gray-50 transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary">
                <i class="fa-solid fa-house mr-2 text-gray-400"></i> Home
            </a>
        </div>
        
    </main>

    <script src="/js/500.js"></script>
</body>
</html>