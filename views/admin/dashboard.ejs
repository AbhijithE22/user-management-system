<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - User Management</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
    
    <link rel="stylesheet" href="/css/adminDashboard.css">
</head>
<body class="bg-background text-textMain">

    <!-- Top Navigation -->
    <nav class="bg-surface border-b border-border sticky top-0 z-30 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <!-- Logo & Brand -->
                <div class="flex items-center">
                    <div class="flex-shrink-0 flex items-center cursor-pointer">
                        <div class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-gray-900 text-white">
                            <i class="fa-solid fa-shield-halved text-sm"></i>
                        </div>
                        <span class="ml-3 font-semibold text-lg text-gray-900 tracking-tight">Admin Portal</span>
                    </div>
                    <div class="hidden md:ml-10 md:flex md:space-x-8">
                        <a href="#" class="border-primary text-gray-900 inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium">
                            Users
                        </a>
                       
                    </div>
                </div>
                
                <!-- Right Side: Admin Profile & Logout -->
                <div class="flex items-center space-x-4">
                    <div class="flex items-center space-x-3">
                        <div class="hidden sm:block text-right">
                            <p class="text-sm font-medium text-gray-900">System Admin</p>
                            <p class="text-xs text-primary font-medium">Superuser</p>
                        </div>
                        <!-- Avatar -->
                        <div class="h-9 w-9 rounded-full bg-gray-200 flex items-center justify-center text-gray-600 shadow-inner border border-white ">
                            <i class="fa-solid fa-user-tie"></i>
                        </div>
                    </div>
                    
                    <div class="h-6 w-px bg-gray-200 hidden sm:block"></div>
                    
                    <button id="logoutBtn" onclick="window.location.href='/admin/logout'" class="text-textMuted hover:text-red-600 transition-colors px-2 py-2 rounded-md text-sm font-medium flex items-center group">
                        <i class="fa-solid fa-arrow-right-from-bracket sm:mr-2 group-hover:translate-x-0.5 transition-transform"></i> 
                        <span class="hidden sm:inline">Logout</span>
                    </button>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        
        <!-- Page Header & Action Bar -->
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-4">
            <div>
                <h1 class="text-2xl font-bold text-gray-900 tracking-tight">User Management</h1>
                <p class="mt-1 text-sm text-textMuted">View, manage, and add users to the system.</p>
            </div>
            
            <div class="flex flex-col sm:flex-row w-full sm:w-auto gap-3">
                <!-- Search Bar -->
                <form action="/admin/dashboard" method="GET" class="relative w-full sm:w-64">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <i class="fa-solid fa-magnifying-glass text-gray-400"></i>
                    </div>

                    <input
                        type="text"
                        name="search"
                        value="<%= search || '' %>"
                        class="input-field block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-lg text-sm placeholder-gray-400 focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary"
                        placeholder="Search users..."
                    >
                </form>
                
                <!-- Add User Button -->
                <button onclick="window.location.href='/admin/add-user'" class="btn-primary inline-flex items-center justify-center px-4 py-2 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-primary hover:bg-primaryHover focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary flex-shrink-0">
                    <i class="fa-solid fa-user-plus mr-2"></i> Add User
                </button>
            </div>
        </div>
            
        <!-- User Table Card -->
        <div class="dashboard-card rounded-xl overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse whitespace-nowrap">
                    <thead class="bg-gray-50 border-b border-border">
                        <tr>
                            <th scope="col" class="px-6 py-3.5 text-xs font-semibold text-gray-500 uppercase tracking-wider">User</th>
                            <th scope="col" class="px-6 py-3.5 text-xs font-semibold text-gray-500 uppercase tracking-wider">Role</th>
                            <th scope="col" class="px-6 py-3.5 text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
                            <th scope="col" class="px-6 py-3.5 text-xs font-semibold text-gray-500 uppercase tracking-wider">Joined</th>
                            <th scope="col" class="px-6 py-3.5 text-xs font-semibold text-gray-500 uppercase tracking-wider text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody>

                    <% users.forEach((user) => { %>

                    <tr class="hover:bg-gray-50 transition-colors group">
                        <td class="px-6 py-4">
                            <div class="flex items-center">
                                <div class="h-9 w-9 rounded-full bg-blue-100 text-primary flex items-center justify-center font-bold text-sm">

                                    <%= user.fullName.substring(0,2).toUpperCase() %>

                                </div>

                                <div class="ml-4">
                                    <div class="text-sm font-medium text-gray-900">
                                        <%= user.fullName %>
                                    </div>

                                    <div class="text-sm text-textMuted">
                                        <%= user.email %>
                                    </div>
                                </div>
                            </div>
                        </td>

                        <td class="px-6 py-4">
                            <div class="text-sm text-gray-900">
                                User
                            </div>
                        </td>

                        <td>
                        <% if(user.status === "Active") { %>
                            <span class="px-3 py-1 rounded-full bg-green-100 text-green-700 text-sm font-medium">
                            Active
                            </span>
                        <% } else { %>
                            <span class="px-3 py-1 rounded-full bg-red-100 text-red-700 text-sm font-medium">
                            Inactive
                            </span>
                        <% } %>
                        </td>

                        <td class="px-6 py-4 text-sm text-textMuted">
                            <%= user.phone %>
                        </td>

                        <td class="px-6 py-4 text-right text-sm font-medium">

                            <a href="/admin/edit-user/<%= user._id %>"
                            class="btn-icon text-gray-400 hover:text-primary p-2 rounded-md hover:bg-blue-50 mr-1">
                                <i class="fa-solid fa-pen"></i>
                            </a>

                            <a href="/admin/delete-user/<%= user._id %>"
                            class="btn-icon text-gray-400 hover:text-red-600 p-2 rounded-md hover:bg-red-50">
                                <i class="fa-solid fa-trash-can"></i>
                            </a>

                        </td>
                    </tr>

                    <% }) %>

                    </tbody>
                </table>
            </div>
            
            
        </div>
        
    </main>

    <!-- Footer -->
    <footer class="mt-auto border-t border-border bg-surface py-5 text-center">
        <p class="text-sm text-textMuted">
            &copy; 2026 Nexus Admin Portal. All rights reserved.
        </p>
    </footer>

    <script src="/js/adminDashboard.js"></script>
</body>
</html>