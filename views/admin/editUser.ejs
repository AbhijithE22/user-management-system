<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - Edit User</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
   <link rel="stylesheet" href="/css/editUser.css"> 
   
</head>
<body class="bg-background text-textMain">

    <!-- Top Navigation -->
    <nav class="bg-surface border-b border-border sticky top-0 z-30 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <!-- Logo & Brand -->
                <div class="flex items-center">
                    <div class="flex-shrink-0 flex items-center cursor-pointer">
                        <div class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-gray-900 text-white">
                            <i class="fa-solid fa-shield-halved text-sm"></i>
                        </div>
                        <span class="ml-3 font-semibold text-lg text-gray-900 tracking-tight">Admin Portal</span>
                    </div>
                    <div class="hidden md:ml-10 md:flex md:space-x-8">
                        <a href="admin-dashboard.html" class="border-primary text-gray-900 inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium">
                            Users
                        </a>
                        <a href="#" class="border-transparent text-textMuted hover:border-gray-300 hover:text-gray-700 inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium transition-colors">
                            Settings
                        </a>
                    </div>
                </div>
                
                <!-- Right Side: Admin Profile & Logout -->
                <div class="flex items-center space-x-4">
                    <div class="flex items-center space-x-3">
                        <div class="hidden sm:block text-right">
                            <p class="text-sm font-medium text-gray-900">System Admin</p>
                            <p class="text-xs text-primary font-medium">Superuser</p>
                        </div>
                        <!-- Avatar -->
                        <div class="h-9 w-9 rounded-full bg-gray-200 flex items-center justify-center text-gray-600 shadow-inner border border-white cursor-pointer">
                            <i class="fa-solid fa-user-tie"></i>
                        </div>
                    </div>
                    
                    <div class="h-6 w-px bg-gray-200 hidden sm:block"></div>
                    
                    <button id="logoutBtn" onclick="handleLogout()" class="text-textMuted hover:text-red-600 transition-colors px-2 py-2 rounded-md text-sm font-medium flex items-center group">
                        <i class="fa-solid fa-arrow-right-from-bracket sm:mr-2 group-hover:translate-x-0.5 transition-transform"></i> 
                        <span class="hidden sm:inline">Logout</span>
                    </button>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="flex-1 w-full max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
        
        <!-- Breadcrumb & Header -->
        <div class="mb-6">
            <nav class="flex text-sm text-textMuted mb-2" aria-label="Breadcrumb">
                <ol class="inline-flex items-center space-x-1 md:space-x-3">
                    <li class="inline-flex items-center">
                        <a href="#" onclick="window.location.href='/admin/dashboard'" class="hover:text-primary transition-colors inline-flex items-center">
                            <i class="fa-solid fa-users mr-2 text-xs"></i>
                            User Management
                        </a>
                    </li>
                    <li>
                        <div class="flex items-center">
                            <i class="fa-solid fa-chevron-right text-gray-400 text-xs mx-1"></i>
                            <span class="text-gray-800 font-medium ml-1 md:ml-2">Edit User</span>
                        </div>
                    </li>
                </ol>
            </nav>
        </div>

        <!-- Edit User Form Card -->
        <div class="dashboard-card rounded-xl overflow-hidden">
            
            <div class="px-6 py-5 border-b border-border bg-white sm:px-8">
                <h2 class="text-xl font-semibold text-gray-900">Edit User Profile</h2>
                <p class="mt-1 text-sm text-textMuted">Update information for this existing user account.</p>
            </div>

            <div class="p-6 sm:p-8 bg-white">
                <form action="/admin/edit-user/<%= user._id %>" method="POST"  id="editUserForm" class="space-y-6">
                    
                    <!-- Full Name -->
                    <div class="space-y-1.5">
                        <label for="fullName" class="block text-sm font-medium text-gray-700">Full Name <span class="text-red-500">*</span></label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <i class="fa-regular fa-user text-gray-400"></i>
                            </div>
                            <input 
                                type="text" 
                                name="fullName" 
                                id="fullName" 
                                value="<%= user.fullName %>"
                                class="input-field block w-full pl-10 pr-3 py-2.5 border border-gray-300 rounded-lg text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary" 
                                required>
                        </div>
                    </div>

                    <!-- Email -->
                    <div class="space-y-1.5">
                        <label for="email" class="block text-sm font-medium text-gray-700">Email Address <span class="text-red-500">*</span></label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <i class="fa-regular fa-envelope text-gray-400"></i>
                            </div>
                            <input 
                                type="email" 
                                name="email" 
                                id="email" 
                                value="<%= user.email %>"
                                class="input-field block w-full pl-10 pr-3 py-2.5 border border-gray-300 rounded-lg text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary" 
                                required>
                        </div>
                    </div>
                    

                    <!-- Phone Number -->
                    <div class="space-y-1.5">
                        <label for="phone" class="block text-sm font-medium text-gray-700">Phone Number</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <i class="fa-solid fa-phone text-gray-400 text-sm"></i>
                            </div>
                            <input 
                                type="tel" 
                                name="phone" 
                                id="phone" 
                                value="<%= user.phone %>"
                                class="input-field block w-full pl-10 pr-3 py-2.5 border border-gray-300 rounded-lg text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary">
                        </div>
                    </div>

                    <!-- Status -->
                   <div class="space-y-1.5">
                        <label for="status" class="block text-sm font-medium text-gray-700">
                            Status
                        </label>

                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <i class="fa-solid fa-user-check text-gray-400 text-sm"></i>
                            </div>

                            <select
                                name="status"
                                id="status"
                                class="input-field block w-full pl-10 pr-3 py-2.5 border border-gray-300 rounded-lg text-sm text-gray-900 focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary"
                            >
                                <option value="Active" <%= user.status === "Active" ? "selected" : "" %>>
                                    Active
                                </option>

                                <option value="Inactive" <%= user.status === "Inactive" ? "selected" : "" %>>
                                    Inactive
                                </option>
                            </select>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="pt-6 mt-6 border-t border-gray-100 flex items-center justify-end space-x-3">
                        <button 
                            type="button" 
                            onclick="window.location.href='/admin/dashboard'"
                            class="btn-cancel px-4 py-2 border border-gray-300 rounded-lg shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary">
                            Cancel
                        </button>
                        <button 
                            type="submit" 
                            id="saveBtn"
                            
                            class="btn-primary inline-flex items-center justify-center px-6 py-2 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-primary hover:bg-primaryHover focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary">
                            <i class="fa-solid fa-floppy-disk mr-2"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
        
    </main>

    <!-- Footer -->
    <footer class="mt-auto border-t border-border bg-surface py-5 text-center">
        <p class="text-sm text-textMuted">
            &copy; 2026 Nexus Admin Portal. All rights reserved.
        </p>
    </footer>

    <script src="/js/editUser.js"></script>
</body>
</html>